# Shared HMAC-SHA256 secret (use a strong 64-hex secret in non-local environments)
MYCELIUM_SECRET_KEY=change_me_to_a_strong_64_char_hex_secret
# Optional secondary key for zero-downtime key rotation
MYCELIUM_SECONDARY_SECRET_KEY=

# Allowed timestamp drift in seconds across WAN nodes
MYCELIUM_MAX_CLOCK_SKEW_SECONDS=240

# SQLite storage path (use persistent disk paths on Linux VPS nodes)
MYCELIUM_DB_PATH=./mycelium.db

# Node role and capabilities
MYCELIUM_ROLE=relay
MYCELIUM_CAPABILITIES=general,sync,relay

# Comma-separated peer URLs (prefer WireGuard overlay IPs or HTTPS/TLS endpoints)
MYCELIUM_BOOTSTRAP_PEERS=
