# Mycelium Production Configuration
# Copy this file to .env and replace with strong cryptographic secrets

# REQUIRED: Minimum 32-character secret key for HMAC-SHA256 swarm auth & session signing
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
MYCELIUM_SECRET_KEY=CHANGE_ME_GENERATE_64_CHAR_HEX_SECRET

# Network Bindings (use 127.0.0.1 behind Caddy/Nginx TLS reverse proxy in production)
MYCELIUM_HOST=127.0.0.1
MYCELIUM_PORT=8000
MYCELIUM_UDP_PORT=9999

# Security & Rate Limiting
MYCELIUM_ALLOWED_ORIGINS=https://your-domain.com,http://localhost:8000
MYCELIUM_MAX_PAYLOAD_BYTES=65536
MYCELIUM_RATE_LIMIT_PER_MIN=120

# SQLite Persistence Paths
MYCELIUM_DB_PATH=mycelium.db
MYCELIUM_LEDGER_PATH=ledger.db
MYCELIUM_KNOWLEDGE_PATH=knowledge.db

# WAN Mesh / Global Peer Discovery
# Comma-separated list of public HTTPS seed node URLs (e.g. https://node1.example.com,https://node2.example.com)
MYCELIUM_BOOTSTRAP_PEERS=
# Optional public URL of this node advertised to WAN peers
MYCELIUM_PUBLIC_URL=
