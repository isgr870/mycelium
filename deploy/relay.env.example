# Public Relay / WAN Mesh Node Configuration
MYCELIUM_HOST=127.0.0.1
MYCELIUM_PORT=8000
MYCELIUM_PUBLIC_URL=https://relay.example.com
MYCELIUM_BOOTSTRAP_PEERS=https://relay.example.com
# Must be a strong secret shared across trusted mesh peers (64+ hex chars)
MYCELIUM_SECRET_KEY=REPLACE_WITH_64_CHAR_HEX_SECRET
